#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# ── Flag parsing ──────────────────────────────────────────────────────────────
# --no-eval  skip running-evaluation generation at startup
# All other flags are forwarded to streamlit

SKIP_EVAL=0
STREAMLIT_ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--no-eval" ]; then
    SKIP_EVAL=1
  else
    STREAMLIT_ARGS+=("$arg")
  fi
done

# ── Auth status checks ────────────────────────────────────────────────────────

STRAVA_TOKENS="$HOME/.config/strava-mcp/tokens.json"
MFP_CACHE="$HOME/.config/mfp-mcp/cookies.json"
NOW=$(date +%s)
WARN=0

if [ ! -f "$STRAVA_TOKENS" ]; then
  echo "  Strava  ✗  not authenticated — run: cd ../mcp_strava && .venv/bin/strava-mcp auth"
  WARN=1
else
  EXPIRES=$(python3 -c "import json; print(json.load(open('$STRAVA_TOKENS'))['expires_at'])" 2>/dev/null || echo 0)
  if [ "$EXPIRES" -lt "$NOW" ]; then
    echo "  Strava  ⚠  token expired — will auto-refresh on first request"
  else
    echo "  Strava  ✓"
  fi
fi

# Load .env if present (picks up ANTHROPIC_API_KEY, ENABLE_CLAUDE_CHAT, etc.)
if [ -f ".env" ]; then
  while IFS='=' read -r key val; do
    [[ "$key" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$key" ]] && continue
    export "$key"="$val"
  done < .env
fi

if [ "${ENABLE_CLAUDE_CHAT:-0}" = "1" ]; then
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "  Claude  ✗  ANTHROPIC_API_KEY not set (required when ENABLE_CLAUDE_CHAT=1)"
    echo "             add it to health_dashboard/.env"
    WARN=1
  else
    echo "  Claude  ✓"
  fi
fi

MFP_OK=0
if [ ! -f "$MFP_CACHE" ]; then
  echo "  MFP     ✗  not authenticated"
  echo "             run: cd ../mcp_myfitnesspal && .venv/bin/mfp-mcp auth"
  WARN=1
else
  MTIME=$(python3 -c "import os; print(int(os.path.getmtime('$MFP_CACHE')))" 2>/dev/null || echo 0)
  AGE=$(( NOW - MTIME ))
  if [ "$AGE" -gt 43200 ]; then
    echo "  MFP     ⚠  cookie cache stale ($(( AGE / 3600 ))h old)"
    echo "             run: cd ../mcp_myfitnesspal && .venv/bin/mfp-mcp auth"
    WARN=1
  else
    REMAINING=$(( (43200 - AGE) / 60 ))
    echo "  MFP     ✓  (cache expires in ${REMAINING}m)"
    MFP_OK=1
  fi
fi

# ── Running evaluations ───────────────────────────────────────────────────────

if [ "$SKIP_EVAL" -eq 1 ]; then
  echo "  Evals   —  skipped (--no-eval)"
else
  ALL_CACHED=$(.venv/bin/python -c "
from claude_eval import evaluation_is_cached
print('1' if all(evaluation_is_cached(p) for p in ['7d','15d','30d']) else '0')
" 2>/dev/null || echo "0")

  if [ "$ALL_CACHED" = "1" ]; then
    echo "  Evals   ✓  (all cached)"
  else
    .venv/bin/python generate_evals.py || true
  fi
fi

# ── Launch ────────────────────────────────────────────────────────────────────

echo ""
if [ "$WARN" -eq 1 ]; then
  echo "Dashboard starting (some data unavailable — see above)"
else
  echo "Dashboard starting..."
fi
echo "  → http://localhost:8501"
echo ""

export MFP_REQUIRED=$MFP_OK
exec .venv/bin/streamlit run app.py --server.headless false "${STREAMLIT_ARGS[@]+"${STREAMLIT_ARGS[@]}"}"
